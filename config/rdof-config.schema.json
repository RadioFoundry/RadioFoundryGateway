{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radiofoundry.org/schema/rdof-config.schema.json",
  "title": "RadioFoundry Gateway settings",
  "description": "Version 3 (docs/spec/fw/config-v3.md). The C parsers (common/src/site.c, common/src/siteplan.c and each part's own) are the authority: they also check that names exist, who owns what, and what fits the platform.",
  "$ref": "#/$defs/v3",
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,39}$", "description": "Letters, digits, '-', '_' and '.'."},
    "freq": {"type": "number", "exclusiveMinimum": 0, "description": "MHz (below 10000) or Hz."},
    "freq_auto": {"oneOf": [{"$ref": "#/$defs/freq"}, {"const": "auto"}]},
    "freqs_hz": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "integer", "minimum": 30000000, "maximum": 3000000000}
    },
    "max_key_s": {"type": "number", "minimum": 0, "maximum": 60},
    "cc": {"type": "integer", "minimum": 0, "maximum": 15},
    "power": {"type": "integer", "minimum": 0, "maximum": 255},
    "slot": {"type": "integer", "minimum": 1, "maximum": 2},
    "gpio": {"type": "integer", "minimum": 0, "maximum": 48},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "height": {"type": "number"}
      }
    },
    "slot_timing": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/spec/slot-timing.md.",
      "properties": {
        "mode": {"type": "string"},
        "offset_us": {"type": "number"},
        "max_err_us": {"type": "number", "minimum": 0},
        "on_loss": {"type": "string"},
        "holdover_s": {"type": "number", "minimum": 0}
      }
    },
    "oled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {},
        "sh1106": {"type": "boolean"},
        "rotate180": {"type": "boolean"},
        "refresh_s": {"type": "number", "minimum": 0},
        "sda": {"$ref": "#/$defs/gpio"},
        "scl": {"$ref": "#/$defs/gpio"},
        "i2c": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"address": {}, "sh1106": {"type": "boolean"}, "rotate180": {"type": "boolean"}}
        }
      }
    },
    "selftest_load": {"type": "object", "additionalProperties": false, "properties": {"channels": {}, "rates": {}}},
    "dev_bench": {
      "type": "object",
      "description": "What the bench may transmit on this device.",
      "additionalProperties": false,
      "properties": {"freqs_hz": {"$ref": "#/$defs/freqs_hz"}, "max_key_s": {"$ref": "#/$defs/max_key_s"}}
    },
    "port": {
      "type": "object",
      "description": "One of the board's UARTs, a USB device, or a serial device's path (a host).",
      "oneOf": [
        {
          "required": ["uart", "tx", "rx"],
          "additionalProperties": false,
          "properties": {
            "uart": {"enum": [1, 2], "description": "UART0 is the console."},
            "tx": {"$ref": "#/$defs/gpio"},
            "rx": {"$ref": "#/$defs/gpio"},
            "rts": {"type": "integer", "minimum": -1, "maximum": 48},
            "cts": {"type": "integer", "minimum": -1, "maximum": 48},
            "baud": {"$ref": "#/$defs/baud"}
          }
        },
        {
          "required": ["usb"],
          "additionalProperties": false,
          "properties": {
            "usb": {"enum": ["auto", "cdc-acm", "uart"], "description": "auto: a modem found by its kind."},
            "vid": {"$ref": "#/$defs/usb_id"},
            "pid": {"$ref": "#/$defs/usb_id"},
            "serial": {"type": "string", "maxLength": 31},
            "usb_port": {"type": "string", "maxLength": 15},
            "baud": {"$ref": "#/$defs/baud"}
          }
        },
        {
          "required": ["path"],
          "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 63}, "baud": {"$ref": "#/$defs/baud"}}
        }
      ]
    },
    "baud": {"type": "integer", "minimum": 1200, "maximum": 6000000},
    "usb_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9A-Fa-f]{1,4}$"},
        {"type": "integer", "minimum": 0, "maximum": 65535}
      ]
    },
    "sdr_keys": {
      "description": "A sample stream in, and out if it has \"tx\".",
      "properties": {
        "kind": {"const": "sdr"},
        "driver": {"enum": ["rtlsdr", "lr2021", "sx1255", "sim", "soapy", "iio"]},
        "match": {
          "type": "object",
          "description": "Which one, when there are several alike.",
          "additionalProperties": false,
          "properties": {
            "serial": {"type": "string"},
            "usb_port": {"type": "string"},
            "uri": {"type": "string"},
            "args": {"type": "string"},
            "index": {"type": "integer", "minimum": 0}
          }
        },
        "rx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rate": {"type": "number", "exclusiveMinimum": 0, "description": "Samples a second."},
            "center_hz": {"$ref": "#/$defs/freq_auto"},
            "gain_db": {"oneOf": [{"type": "number"}, {"const": "auto"}]},
            "agc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {},
                "clip": {},
                "headroom_db": {"type": "number"},
                "hold_s": {"type": "number"},
                "relax_s": {"type": "number"},
                "settle_s": {"type": "number"}
              }
            },
            "ppm": {"type": "number"},
            "biastee": {"type": "boolean"},
            "iq_bits": {"type": "integer"}
          }
        },
        "tx": {
          "type": "object",
          "description": "It transmits: the router tunes a carrier for each stream it sends.",
          "additionalProperties": false,
          "properties": {
            "carriers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Carriers at once; the front end says how many it runs."
            },
            "power_dbm": {"type": "number", "minimum": -60, "maximum": 30},
            "center_hz": {"$ref": "#/$defs/freq_auto"},
            "bench": {"$ref": "#/$defs/dev_bench"}
          }
        },
        "bench": {"$ref": "#/$defs/dev_bench"},
        "usb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transfers": {"type": "integer", "minimum": 1},
            "transfer_kb": {"type": "integer", "minimum": 1}
          }
        },
        "dsp_cores": {"enum": [1, 2]},
        "spike": {"type": "boolean"},
        "selftest": {"type": "boolean"},
        "sim": {},
        "idle_gate": {},
        "learn_ppm": {},
        "sim_ppm": {"type": "number"},
        "afc": {},
        "rssi_offset": {"type": "number"},
        "status_seconds": {"type": "number", "minimum": 0}
      }
    },
    "modem_keys": {
      "description": "Anything that speaks MMDVM on a serial port.",
      "required": ["port"],
      "properties": {
        "kind": {"const": "modem"},
        "type": {"enum": ["auto", "radio_hotspot", "mmdvm_hs", "mmdvm"]},
        "port": {"$ref": "#/$defs/port"},
        "needs": {
          "type": "array",
          "description": "What its description must say, checked when it's opened.",
          "items": {"enum": ["duplex", "split", "dcdm", "sfr"]}
        },
        "mmdvm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rx_invert": {},
            "tx_invert": {},
            "ptt_invert": {},
            "tx_delay_ms": {},
            "rx_level": {},
            "tx_level": {},
            "cwid_level": {},
            "rx_dc_offset": {},
            "tx_dc_offset": {},
            "dmr_delay": {},
            "rx_offset_hz": {},
            "tx_offset_hz": {},
            "headers": {},
            "terminators": {},
            "rssi": {},
            "protocol": {},
            "modem_address": {},
            "tuner": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"type": {"type": "string"}, "freq": {}, "settle_ms": {"type": "number", "minimum": 0}}
            }
          }
        },
        "bench": {"$ref": "#/$defs/dev_bench"}
      }
    },
    "radio_keys": {
      "description": "A RadioFoundry radio on its debug link (a bench device).",
      "required": ["port"],
      "properties": {
        "kind": {"const": "radio"},
        "port": {"$ref": "#/$defs/port"},
        "bench": {"$ref": "#/$defs/dev_bench"}
      }
    },
    "split": {
      "type": "object",
      "description": "A repeater app whose in and out are two devices.",
      "additionalProperties": false,
      "properties": {
        "power_cap": {},
        "prebuffer": {},
        "lease_s": {"type": "number", "minimum": 0},
        "cooldown_s": {"type": "number", "minimum": 0},
        "max_key_s": {"type": "number", "minimum": 0}
      }
    },
    "idset": {
      "description": "IDs: 202, \"3100-3199\", \"*\", \"!350\", a list of those, the same as one comma-separated string, or false (none).",
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 16777215},
        {
          "type": "string",
          "pattern": "^\\s*!?(\\*|[0-9]+(\\s*-\\s*[0-9]+)?)\\s*(,\\s*!?(\\*|[0-9]+(\\s*-\\s*[0-9]+)?)\\s*)*$"
        },
        {"const": false},
        {
          "type": "array",
          "items": {
            "anyOf": [
              {"type": "integer", "minimum": 0, "maximum": 16777215},
              {
                "type": "string",
                "pattern": "^\\s*!?(\\*|[0-9]+(\\s*-\\s*[0-9]+)?)\\s*(,\\s*!?(\\*|[0-9]+(\\s*-\\s*[0-9]+)?)\\s*)*$"
              }
            ]
          }
        }
      ]
    },
    "name3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^[^/\"\\\\]+$",
      "description": "Under 40 characters, without '/', '\"' or '\\'."
    },
    "fref": {"description": "A frequency's name, or its frequency.", "type": ["string", "number"]},
    "policy_keys": {
      "description": "Which calls a path carries (config-v3.md section 8).",
      "properties": {
        "tg": {"$ref": "#/$defs/idset"},
        "ptt": {"$ref": "#/$defs/idset"},
        "ptt_hold_s": {"type": "integer", "minimum": 0},
        "pc": {"$ref": "#/$defs/idset"},
        "apps": {"anyOf": [{"const": "*"}, {"const": false}, {"type": "array", "items": {"type": "string"}}]},
        "net": {"type": "string"},
        "dir": {"enum": ["both", "rf>net", "net>rf"]}
      }
    },
    "policy3": {
      "type": "object",
      "required": ["name"],
      "$ref": "#/$defs/policy_keys",
      "properties": {"name": {"$ref": "#/$defs/name3"}},
      "unevaluatedProperties": false
    },
    "slot_policy": {
      "anyOf": [
        {"type": "string", "description": "A named policy."},
        {
          "type": "object",
          "$ref": "#/$defs/policy_keys",
          "properties": {"policy": {"type": "string"}},
          "unevaluatedProperties": false
        }
      ]
    },
    "slots3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"1": {"$ref": "#/$defs/slot_policy"}, "2": {"$ref": "#/$defs/slot_policy"}}
    },
    "defaults3": {
      "type": "object",
      "$ref": "#/$defs/policy_keys",
      "properties": {
        "cc": {"anyOf": [{"$ref": "#/$defs/cc"}, {"const": -1}]},
        "mode": {"enum": ["simplex", "sfr", "dcdm"]},
        "ts": {"enum": [1, 2]},
        "tx": {"type": "boolean"},
        "power": {"$ref": "#/$defs/power"},
        "policy": {"type": "string"}
      },
      "unevaluatedProperties": false
    },
    "active_slots": {
      "type": "array",
      "items": {"enum": [1, 2]},
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "description": "The slots it repeats (default both)."
    },
    "freq3": {
      "anyOf": [
        {"$ref": "#/$defs/freq"},
        {
          "type": "object",
          "required": ["freq"],
          "$ref": "#/$defs/policy_keys",
          "properties": {
            "freq": {"$ref": "#/$defs/freq"},
            "name": {"$ref": "#/$defs/name3"},
            "cc": {"anyOf": [{"$ref": "#/$defs/cc"}, {"const": -1}]},
            "mode": {"enum": ["simplex", "sfr", "dcdm"]},
            "ts": {"enum": [1, 2]},
            "tx": {"type": "boolean"},
            "power": {"$ref": "#/$defs/power"},
            "devices": {"type": "array", "items": {"type": "string"}},
            "slots": {"$ref": "#/$defs/slots3"},
            "policy": {"type": "string"},
            "hang_s": {"type": "number", "minimum": 0},
            "call_hang_s": {"type": "number", "minimum": 0},
            "inbound_slot": {"$ref": "#/$defs/slot"},
            "short_lc_ts1_low": {"type": "boolean"},
            "slot_timing": {"$ref": "#/$defs/slot_timing"},
            "duplex": {"enum": ["half", "full"], "description": "On an SDR: full transmits while it receives."},
            "active_slots": {"$ref": "#/$defs/active_slots"},
            "cwid": {"type": "string"},
            "cwid_every_s": {"type": "number", "minimum": 0},
            "prebuffer": {},
            "jitter_buffer": {},
            "jitter_min_ms": {"type": "number", "minimum": 0},
            "jitter_max_ms": {"type": "number", "minimum": 0}
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "dev3_own": {
      "description": "Version 3's device keys: where it listens, where it may transmit, and how a device that transmits on several frequencies waits and answers.",
      "properties": {
        "name": {"$ref": "#/$defs/name3"},
        "hears": {
          "anyOf": [
            {"const": false},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idle": {"$ref": "#/$defs/fref"},
                "scan": {"type": "array", "items": {"$ref": "#/$defs/fref"}},
                "dwell_s": {"type": "number", "minimum": 0},
                "hang_s": {"type": "number", "minimum": 0},
                "carrier_s": {"type": "number", "minimum": 0}
              }
            }
          ]
        },
        "transmits": {"anyOf": [{"const": false}, {"type": "array", "items": {"$ref": "#/$defs/fref"}}]},
        "listen_s": {"type": "number", "minimum": 0},
        "clear_s": {"type": "number", "minimum": 0},
        "idle_after_s": {"type": "number", "minimum": 0},
        "csbk_preambles": {"type": "integer", "minimum": 0},
        "answer_s": {"type": "number", "minimum": 0},
        "answer_max_s": {"type": "number", "minimum": 0},
        "prebuffer": {},
        "jitter_buffer": {},
        "jitter_min_ms": {"type": "number", "minimum": 0},
        "jitter_max_ms": {"type": "number", "minimum": 0},
        "cwid": {"type": "string"},
        "cwid_every_s": {"type": "number", "minimum": 0}
      }
    },
    "sdr_device3": {
      "allOf": [{"$ref": "#/$defs/sdr_keys"}, {"$ref": "#/$defs/dev3_own"}],
      "unevaluatedProperties": false
    },
    "modem_device3": {
      "allOf": [{"$ref": "#/$defs/modem_keys"}, {"$ref": "#/$defs/dev3_own"}],
      "unevaluatedProperties": false
    },
    "radio_device3": {
      "allOf": [{"$ref": "#/$defs/radio_keys"}, {"$ref": "#/$defs/dev3_own"}],
      "unevaluatedProperties": false
    },
    "device3": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"enum": ["sdr", "modem", "radio"]}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "sdr"}}}, "then": {"$ref": "#/$defs/sdr_device3"}},
        {"if": {"properties": {"kind": {"const": "modem"}}}, "then": {"$ref": "#/$defs/modem_device3"}},
        {"if": {"properties": {"kind": {"const": "radio"}}}, "then": {"$ref": "#/$defs/radio_device3"}}
      ]
    },
    "repeater3": {
      "required": ["in", "out"],
      "$ref": "#/$defs/policy_keys",
      "properties": {
        "name": {"$ref": "#/$defs/name3"},
        "type": {"const": "repeater"},
        "in": {"$ref": "#/$defs/fref"},
        "out": {"$ref": "#/$defs/fref"},
        "slots": {"$ref": "#/$defs/slots3"},
        "policy": {"type": "string"},
        "hang_s": {"type": "number", "minimum": 0},
        "call_hang_s": {"type": "number", "minimum": 0},
        "short_lc_ts1_low": {"type": "boolean"},
        "slot_timing": {"$ref": "#/$defs/slot_timing"},
        "split": {"$ref": "#/$defs/split"},
        "cwid": {"type": "string"},
        "cwid_every_s": {"type": "number", "minimum": 0},
        "prebuffer": {},
        "jitter_buffer": {},
        "jitter_min_ms": {"type": "number", "minimum": 0},
        "jitter_max_ms": {"type": "number", "minimum": 0},
        "active_slots": {"$ref": "#/$defs/active_slots"}
      },
      "unevaluatedProperties": false
    },
    "parrot3": {
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name3"},
        "type": {"const": "parrot"},
        "tg": {"$ref": "#/$defs/idset"},
        "pc": {"$ref": "#/$defs/idset"}
      }
    },
    "ipgw3": {
      "description": "The IP gateway (common/src/ipgwcfg.c checks its keys).",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name3"},
        "type": {"const": "ipgw"},
        "tg": {"$ref": "#/$defs/idset"},
        "pc": {"$ref": "#/$defs/idset"},
        "radio_net": true,
        "tx": true,
        "ack": true,
        "max_bytes": true,
        "up_pps": true,
        "down_pps": true,
        "idle_s": true,
        "max_flows": true,
        "routes": true,
        "nat": true
      }
    },
    "app3": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["repeater", "parrot", "ipgw"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "repeater"}}}, "then": {"$ref": "#/$defs/repeater3"}},
        {"if": {"properties": {"type": {"const": "parrot"}}}, "then": {"$ref": "#/$defs/parrot3"}},
        {"if": {"properties": {"type": {"const": "ipgw"}}}, "then": {"$ref": "#/$defs/ipgw3"}}
      ]
    },
    "hblink3": {
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name3"},
        "type": {"const": "hblink"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "transport": {"enum": ["udp", "sctp"]},
        "sctp_encap_port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "sctp_heartbeat_ms": {"type": "integer", "minimum": 0},
        "sctp_max_retransmit": {"type": "integer", "minimum": 0},
        "sctp_ttl_ms": {"type": "integer", "minimum": 0},
        "identity": {"enum": ["single", "per_path"]},
        "peer_ids": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 4294967295}},
        "roaming": {"type": "boolean"}
      }
    },
    "mqtt3": {
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name3"},
        "type": {"const": "mqtt"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "username": {"type": "string"},
        "password": {"type": "string"},
        "root": {"type": "string"},
        "tls": {"type": "boolean"},
        "report": {"type": "boolean"},
        "calls": {"type": "boolean"}
      }
    },
    "net3": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["hblink", "mqtt"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "hblink"}}}, "then": {"$ref": "#/$defs/hblink3"}},
        {"if": {"properties": {"type": {"const": "mqtt"}}}, "then": {"$ref": "#/$defs/mqtt3"}}
      ]
    },
    "v3": {
      "description": "Version 3: devices, frequencies, apps, networks and the policies that say which calls move between a talk path and a network (docs/spec/fw/config-v3.md).",
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 3},
        "name": {"type": "string", "description": "The box's name (MQTT topics, the screen)."},
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777215,
          "description": "The box's DMR ID: its HBlink peer ID."
        },
        "callsign": {"type": "string"},
        "location": {"$ref": "#/$defs/location"},
        "defaults": {"$ref": "#/$defs/defaults3"},
        "devices": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/device3"}},
        "frequencies": {"type": "array", "maxItems": 48, "items": {"$ref": "#/$defs/freq3"}},
        "apps": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/app3"}},
        "networks": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/net3"}},
        "policies": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/policy3"}},
        "pc_hold_s": {"type": "integer", "minimum": 0},
        "wifi": {"$ref": "#/$defs/wifi"},
        "ntp": {"$ref": "#/$defs/ntp"},
        "oled": {"$ref": "#/$defs/oled"},
        "slot_timing": {"$ref": "#/$defs/slot_timing"},
        "usb_hub": {"$ref": "#/$defs/usb_hub"},
        "selftest_load": {"$ref": "#/$defs/selftest_load"},
        "bench": {"$ref": "#/$defs/bench"}
      }
    },
    "wifi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ssid": {"type": "string"},
              "password": {"type": "string"},
              "priority": {"type": "integer"},
              "hidden": {"type": "boolean"}
            }
          }
        }
      }
    },
    "ntp": {
      "description": "The clock: NTP servers (spaces, commas or semicolons between them), or an object.",
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "servers": {"type": "string"},
            "poll_s": {"type": "number", "minimum": 0},
            "clock": {
              "enum": ["netclock", "os"],
              "description": "Host tools only (the board always runs netclock): netclock disciplines its own clock from the servers; os leaves the time to the OS (chrony, ntpd). Default: netclock when servers are set, else os."
            }
          }
        }
      ]
    },
    "usb_hub": {"type": "boolean", "description": "A USB hub on the board's OTG port: a radio and an RTL-SDR at once."},
    "bench": {
      "type": "object",
      "description": "What the bench API may use (docs/spec/bench-api.md).",
      "additionalProperties": false,
      "properties": {
        "devices": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true},
        "tx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "freqs_hz": {"$ref": "#/$defs/freqs_hz"},
            "bands_hz": {
              "type": "array",
              "maxItems": 8,
              "description": "[low, high] in Hz: any frequency from one to the other.",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "integer", "minimum": 30000000, "maximum": 3000000000}
              }
            },
            "max_key_s": {"$ref": "#/$defs/max_key_s"},
            "rf_level": {"type": "integer", "minimum": 0, "maximum": 255},
            "arm_gpio": {"type": "integer", "minimum": -1, "maximum": 48}
          }
        }
      }
    }
  }
}
