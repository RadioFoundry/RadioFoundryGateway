// A ham DMR Tier III site, as recommended for every ham site, on a PlutoSDR on its own: one carrier, the control
// channel on TS1 and a payload channel on TS2. Set the site number (0-1022, chosen with the neighbors) and the
// carrier's logical channel number to 4 x site + 1 (site 5: 21). Every ham site has model huge, NET 1, PAR ab and color
// code 1, so any radio set up for the recommendation takes it. Radios use their RadioID DMR IDs and BrandMeister
// talkgroup numbers; registration is open and no key is asked.
{
  "version": 3,
  "name": "t3site",
  "id": 9800100,
  "callsign": "N0CALL",
  "defaults": {"cc": 1},
  "devices": [
    {"name": "pluto", "kind": "sdr", "driver": "iio", "match": {"uri": "local:"}, "tx": {}}
  ],
  "frequencies": [
    {"name": "A-out", "freq": 442.0125},
    {"name": "A-in", "freq": 447.0125, "tx": false}
  ],
  "apps": [
    {"name": "site", "type": "tier3",
     "system": {"model": "huge", "net": 1, "site": 5, "par": "ab"},
     "carriers": [
       {"out": "A-out", "in": "A-in", "chan": 21, "tscc": true}
     ],
     "registration": "open",
     "ms": "*",
     "private": "*",
     "tg": "*",
     "auth": "off"}
  ],
  "ntp": {"servers": "time-a-g.nist.gov time-a-b.nist.gov tick.usno.navy.mil tock.usno.navy.mil time.apple.com time.cloudflare.com"},
  // the bench (rdofradio --bench 7373): its jobs may transmit anywhere in the US amateur bands from 6 m to 13 cm,
  // keyed 10 s at most, at the transmitter's least power (add "rf_level" 0..255, or "max_dbm", for more)
  "bench": {
    "tx": {
      "bands_hz": [
        [50000000, 54000000], [144000000, 148000000], [222000000, 225000000], [420000000, 450000000],
        [902000000, 928000000], [1240000000, 1300000000], [2300000000, 2310000000], [2390000000, 2450000000]
      ],
      "max_key_s": 10
    }
  }
}
