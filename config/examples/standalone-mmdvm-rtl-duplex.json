// A duplex MMDVM modem as a repeater, with an RTL-SDR that also hears its input (the second entry on
// the input frequency is the RTL-SDR's: it reports level, BER and the spectrum): no network. Parrot on TG 9990, the
// IP gateway at ID 9991.
{
  "version": 3,
  "name": "repeater",
  "id": 9800100,
  "callsign": "N0CALL",
  "defaults": {"cc": 1},
  "devices": [
    {"name": "modem", "kind": "modem", "type": "mmdvm", "port": {"path": "/dev/ttyAMA0"}},
    {"name": "rtl", "kind": "sdr", "driver": "rtlsdr", "rx": {"rate": 288000}}
  ],
  "frequencies": [
    {"name": "in", "freq": 438.25},
    {"name": "out", "freq": 438.75},
    {"name": "in (rtl)", "freq": 438.25, "tx": false}
  ],
  "apps": [
    {"name": "R1", "type": "repeater", "in": "in", "out": "out"},
    {"type": "parrot", "tg": 9990},
    {"type": "ipgw", "tg": 9991, "nat": true}
  ]
}
