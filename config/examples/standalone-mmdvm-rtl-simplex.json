// A simplex MMDVM hotspot board that transmits, with an RTL-SDR that also hears the frequency (its receiver reports
// level, BER and the spectrum): no network. Parrot on TG 9990, the IP gateway at ID 9991.
{
  "version": 3,
  "name": "hotspot",
  "id": 9800100,
  "callsign": "N0CALL",
  "defaults": {"cc": 1},
  "devices": [
    {"name": "hat", "kind": "modem", "type": "mmdvm_hs", "port": {"path": "/dev/ttyAMA0"}, "transmits": [438.5]},
    {"name": "rtl", "kind": "sdr", "driver": "rtlsdr", "rx": {"rate": 288000}}
  ],
  "frequencies": [438.5],
  "apps": [
    {"type": "parrot", "tg": 9990},
    {"type": "ipgw", "tg": 9991, "nat": true}
  ],
  // the clock: public servers that don't smear a leap second (no pool)
  "ntp": {"servers": "time-a-g.nist.gov time-a-b.nist.gov tick.usno.navy.mil tock.usno.navy.mil time.apple.com time.cloudflare.com"},
  // the bench (rdofradio --bench 7373): its jobs may transmit anywhere in the US amateur bands from 6 m to 13 cm,
  // keyed 10 s at most, at the transmitter's least power (add "rf_level" 0..255, or "max_dbm", for more)
  "bench": {
    "tx": {
      "bands_hz": [
        [50000000, 54000000], [144000000, 148000000], [222000000, 225000000], [420000000, 450000000],
        [902000000, 928000000], [1240000000, 1300000000], [2300000000, 2310000000], [2390000000, 2450000000]
      ],
      "max_key_s": 10
    }
  }
}
