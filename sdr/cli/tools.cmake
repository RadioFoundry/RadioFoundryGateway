# The host tools: rdofsdr (always) and rdofradio (with a device library). Included by the top-level CMakeLists.txt
# and host-tests/sdr.cmake once rdof_sdr (and rdof_pffft) exist; rdof_hostweb is added by whoever includes this.
#   SoapySDR (Debian / Ubuntu libsoapysdr-dev, Homebrew soapysdr): rdofsdr --soapy, rdofradio --soapy
#   libiio 0.x (libiio-dev, or a PlutoSDR's own), with libad9361 if found: rdofradio --iio, an AD9361 straight
#   libmosquitto 2.x (libmosquitto-dev, Homebrew mosquitto; the PlutoSDR build makes its own): rdofradio's MQTT
#   RDOF_HOST_WEB: rdofradio --web
#   RDOF_VERSION: the version rdofradio reports (default: git describe at configure time)
set(RDOF_CLI ${CMAKE_CURRENT_LIST_DIR})
find_package(Threads REQUIRED)

add_executable(rdofsdr ${RDOF_CLI}/rdofsdr.c)
target_link_libraries(rdofsdr PRIVATE rdof_sdr)
set_target_properties(rdofsdr PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_compile_options(rdofsdr PRIVATE -Wall -Wno-unused-parameter)
if(TARGET rdof_pffft)
    target_link_libraries(rdofsdr PRIVATE rdof_pffft)
endif()

find_path(SOAPYSDR_INCLUDE_DIR SoapySDR/Device.h)
find_library(SOAPYSDR_LIBRARY SoapySDR)
find_path(IIO_INCLUDE_DIR iio.h)
find_library(IIO_LIBRARY iio)
find_path(MOSQUITTO_INCLUDE_DIR mosquitto.h)
find_library(MOSQUITTO_LIBRARY NAMES mosquitto_static mosquitto) # the static one first (the PlutoSDR build)
find_path(AD9361_INCLUDE_DIR ad9361.h)
find_library(AD9361_LIBRARY ad9361)
set(RDOF_RADIO_SRCS ${RDOF_CLI}/rdofradio.c ${RDOF_CLI}/rdofradio_cfg.c ${RDOF_CLI}/rdofradio_serial.c
    ${RDOF_CLI}/rdofradio_net.c)
set(RDOF_RADIO_DEFS)
set(RDOF_RADIO_INCS)
set(RDOF_RADIO_LIBS)
if(SOAPYSDR_INCLUDE_DIR AND SOAPYSDR_LIBRARY)
    message(STATUS "SoapySDR found: rdofsdr --soapy, rdofradio --soapy")
    target_compile_definitions(rdofsdr PRIVATE RDOF_SOAPY)
    target_include_directories(rdofsdr PRIVATE ${SOAPYSDR_INCLUDE_DIR})
    target_link_libraries(rdofsdr PRIVATE ${SOAPYSDR_LIBRARY})
    list(APPEND RDOF_RADIO_SRCS ${RDOF_CLI}/rdofradio_soapy.c)
    list(APPEND RDOF_RADIO_DEFS RDOF_SOAPY)
    list(APPEND RDOF_RADIO_INCS ${SOAPYSDR_INCLUDE_DIR})
    list(APPEND RDOF_RADIO_LIBS ${SOAPYSDR_LIBRARY})
else()
    message(STATUS "SoapySDR not found: rdofsdr reads files only")
endif()
if(IIO_INCLUDE_DIR AND IIO_LIBRARY)
    message(STATUS "libiio found: rdofradio --iio")
    list(APPEND RDOF_RADIO_SRCS ${RDOF_CLI}/rdofradio_iio.c)
    list(APPEND RDOF_RADIO_DEFS RDOF_IIO)
    list(APPEND RDOF_RADIO_INCS ${IIO_INCLUDE_DIR})
    list(APPEND RDOF_RADIO_LIBS ${IIO_LIBRARY})
    if(AD9361_INCLUDE_DIR AND AD9361_LIBRARY)
        message(STATUS "libad9361 found: rdofradio --iio below 2.083 MS/s")
        list(APPEND RDOF_RADIO_DEFS RDOF_AD9361)
        list(APPEND RDOF_RADIO_INCS ${AD9361_INCLUDE_DIR})
        list(APPEND RDOF_RADIO_LIBS ${AD9361_LIBRARY})
    endif()
endif()

# rdofchz: bring-up of the FPGA channelizer on a PlutoSDR (/dev/mem, and libiio for its frames)
if(UNIX)
    add_executable(rdofchz ${RDOF_CLI}/rdofchz.c)
    target_link_libraries(rdofchz PRIVATE rdof_sdr m)
    set_target_properties(rdofchz PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
    target_compile_options(rdofchz PRIVATE -Wall -Wno-unused-parameter)
    if(IIO_INCLUDE_DIR AND IIO_LIBRARY)
        target_compile_definitions(rdofchz PRIVATE RDOF_IIO)
        target_include_directories(rdofchz PRIVATE ${IIO_INCLUDE_DIR})
        target_link_libraries(rdofchz PRIVATE ${IIO_LIBRARY})
    endif()
endif()

if(RDOF_RADIO_DEFS AND NOT WIN32)
    # rdofradio: a device that transmits, run as the repeater or the transceiver (rdofradio.c)
    add_executable(rdofradio ${RDOF_RADIO_SRCS})
    target_compile_definitions(rdofradio PRIVATE ${RDOF_RADIO_DEFS})
    target_include_directories(rdofradio PRIVATE ${RDOF_RADIO_INCS})
    target_link_libraries(rdofradio PRIVATE rdof_sdr ${RDOF_RADIO_LIBS} Threads::Threads)
    set_target_properties(rdofradio PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
    target_compile_options(rdofradio PRIVATE -Wall -Wno-unused-parameter)
    if(TARGET rdof_pffft)
        target_link_libraries(rdofradio PRIVATE rdof_pffft)
    endif()
    # MQTT, as the board publishes: libmosquitto (EPL-2.0 / EDL-1.0, linked)
    if(MOSQUITTO_INCLUDE_DIR AND MOSQUITTO_LIBRARY)
        message(STATUS "libmosquitto found: rdofradio publishes to MQTT")
        target_sources(rdofradio PRIVATE ${RDOF_CLI}/rdofradio_mqtt.c)
        target_compile_definitions(rdofradio PRIVATE RDOF_MQTT)
        target_include_directories(rdofradio PRIVATE ${MOSQUITTO_INCLUDE_DIR})
        target_link_libraries(rdofradio PRIVATE ${MOSQUITTO_LIBRARY})
    else()
        message(STATUS "libmosquitto not found: rdofradio without MQTT")
    endif()
    # the clock: netclock's POSIX glue (components/netclock), the board's NTP disciplined clock or the OS's
    if(UNIX AND NOT TARGET netclock_posix)
        add_subdirectory(${RDOF_CLI}/../../components/netclock ${CMAKE_BINARY_DIR}/netclock-posix)
    endif()
    if(TARGET netclock_posix)
        target_link_libraries(rdofradio PRIVATE netclock_posix)
        target_compile_definitions(rdofradio PRIVATE RDOF_NETCLOCK)
    endif()
    # the version /api/status shows: RDOF_VERSION, else git describe, else "dev"
    if(NOT RDOF_VERSION)
        execute_process(COMMAND git -C ${RDOF_CLI} describe --always --dirty OUTPUT_VARIABLE RDOF_GIT
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        set(RDOF_VERSION "${RDOF_GIT}")
        if(NOT RDOF_VERSION)
            set(RDOF_VERSION dev)
        endif()
    endif()
    target_compile_definitions(rdofradio PRIVATE RDOF_VERSION="${RDOF_VERSION}")
    option(RDOF_HOST_WEB "Link the web page server into the host tools (rdofradio --web [ADDR:]PORT)" OFF)
    if(RDOF_HOST_WEB)
        target_link_libraries(rdofradio PRIVATE rdof_hostweb)
        target_compile_definitions(rdofradio PRIVATE RDOF_HOST_WEB)
    endif()
endif()

if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
    target_link_options(rdofsdr PRIVATE -fsanitize=address,undefined)
    if(TARGET rdofchz)
        target_link_options(rdofchz PRIVATE -fsanitize=address,undefined)
    endif()
    if(TARGET rdofradio)
        target_link_options(rdofradio PRIVATE -fsanitize=address,undefined)
    endif()
endif()
