# The receive and transmit paths in IRAM (ESP-IDF): out of the cache that Wi-Fi and the PSRAM sample buffer share,
# so a cache miss never holds the reader past the FIFO. Static functions too: each has its own section. (The ESP-IDF
# HAL and port, both esp_idf.c, mark theirs IRAM_ATTR: two objects of one name confuse a fragment.)
[mapping:lr2021]
archive: liblr2021.a
entries:
    lr2021:wait_busy (noflash)
    lr2021:xfer_rx (noflash)
    lr2021:xfer (noflash)
    lr2021:check (noflash)
    lr2021:lr2021_get_status (noflash)
    lr2021:lr2021_send (noflash)
    lr2021:lr2021_write (noflash)
    lr2021:lr2021_read (noflash)
    lr2021:lr2021_read_fifo (noflash)
    lr2021:lr2021_rx_fifo_level (noflash)
    lr2021:lr2021_fifo_flags_peek (noflash)
    lr2021:lr2021_tx_fifo_level (noflash)
    lr2021:lr2021_write_tx_fifo (noflash)
    lr2021:lr2021_irq (noflash)
    lr2021:lr2021_wait_irq (noflash)
    lr2021:lr2021_has_irq (noflash)
    lr2021_cmd:put_op (noflash)
    lr2021_cmd:put32 (noflash)
    lr2021_cmd:lr2021_cmd (noflash)
    lr2021_cmd:lr2021_status (noflash)
    lr2021_cmd:lr2021_cmd_clear_irq (noflash)
    lr2021_cmd:lr2021_cmd_clear_fifo_flags (noflash)
    lr2021_iq:use_irq (noflash)
    lr2021_iq:irq_level (noflash)
    lr2021_iq:rearm (noflash)
    lr2021_iq:drain (noflash)
    lr2021_iq:lr2021_iq_poll (noflash)
    lr2021_tx_stream:lr2021_tx_stream (noflash)
