# The corners of sdr: bad arguments, an allocator that runs out at every step, the idle gate and the demod's skip,
# the two-core split, the clocks, the CPU bench, and the extra cases of the reference tables.
# (built on the receive path alone: the SDR modem has its own tests)
file(GLOB RDOF_SDR_CORE_SRCS ${CMAKE_CURRENT_SOURCE_DIR}/../sdr/src/*.c)
list(FILTER RDOF_SDR_CORE_SRCS EXCLUDE REGEX "/(sdrmodem|loopback)\\.c$")
add_library(rdof_sdr_core STATIC ${RDOF_SDR_CORE_SRCS})
target_include_directories(rdof_sdr_core PUBLIC ../sdr/include)
target_link_libraries(rdof_sdr_core PUBLIC rdof_common)
set_target_properties(rdof_sdr_core PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_compile_options(rdof_sdr_core PRIVATE -Wall -Wno-unused-parameter)
if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
    target_compile_options(rdof_sdr_core PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()
add_executable(rdof_sdr_edge_tests test_sdr_edges.c)
add_dependencies(rdof_sdr_edge_tests rdof_sdr_vectors)
target_include_directories(rdof_sdr_edge_tests PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${RDOF_SDR_GEN})
target_compile_definitions(rdof_sdr_edge_tests PRIVATE RDOF_SDR_DATA="${RDOF_SDR_GEN}/sdr-data/")
target_link_libraries(rdof_sdr_edge_tests PRIVATE rdof_sdr_core m)
set_target_properties(rdof_sdr_edge_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_compile_options(rdof_sdr_edge_tests PRIVATE -Wall -Wno-unused-parameter)
if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
    target_compile_options(rdof_sdr_edge_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(rdof_sdr_edge_tests PRIVATE -fsanitize=address,undefined)
endif()
add_test(NAME rdof_sdr_edge_tests COMMAND rdof_sdr_edge_tests)

