# Every switch off: common's (so no tracker, so no receiver), the SDR AGC, and the built-in FFT,
# which the test then supplies itself (a plain DFT) through the rdof_fft_* hook.
file(GLOB RDOF_SDR_MIN_SRCS ${CMAKE_CURRENT_SOURCE_DIR}/../sdr/src/*.c)
add_library(rdof_sdr_min STATIC ${RDOF_SDR_MIN_SRCS})
target_include_directories(rdof_sdr_min PUBLIC ../sdr/include)
target_link_libraries(rdof_sdr_min PUBLIC rdof_common_min)
target_compile_definitions(rdof_sdr_min PUBLIC RDOF_FEATURE_SDR_AGC=0 RDOF_FEATURE_SDR_BUILTIN_FFT=0)
set_target_properties(rdof_sdr_min PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_compile_options(rdof_sdr_min PRIVATE -Wall -Wno-unused-parameter)
add_executable(rdof_sdr_tests_min test_sdr.c ${RDOF_NC_TEMPCAL})
add_dependencies(rdof_sdr_tests_min rdof_sdr_vectors)
target_include_directories(rdof_sdr_tests_min PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${RDOF_SDR_GEN} ${RDOF_NC_INCLUDE})
target_compile_definitions(rdof_sdr_tests_min PRIVATE RDOF_SDR_DATA="${RDOF_SDR_GEN}/sdr-data/")
target_link_libraries(rdof_sdr_tests_min PRIVATE rdof_sdr_min m)
target_compile_options(rdof_sdr_tests_min PRIVATE -Wall -Wno-unused-parameter -Wno-unused-function)
add_test(NAME rdof_sdr_tests_min COMMAND rdof_sdr_tests_min)

# RDOF_FEATURE_SDR=0 must still build (to nothing).
add_library(rdof_sdr_off STATIC ${RDOF_SDR_MIN_SRCS})
