# Host build of sdr with its golden-vector tests (included from CMakeLists.txt).
add_subdirectory(../sdr sdr)

# The golden vectors (sdr_vectors.h, sdr-data/) are fixtures: an unpublished reference receiver's output for the
# same inputs, committed under fixtures/ (see fixtures/README.md).
set(RDOF_SDR_GEN ${CMAKE_CURRENT_SOURCE_DIR}/fixtures/sdr-vectors)
add_custom_target(rdof_sdr_vectors)

# netclock's settle tracker (the warm-up test) built in, not its sanitized library: the _min build has no sanitizer.
set(RDOF_NC_TEMPCAL ${CMAKE_CURRENT_SOURCE_DIR}/../components/netclock/src/netclock_tempcal.c)
set(RDOF_NC_INCLUDE ${CMAKE_CURRENT_SOURCE_DIR}/../components/netclock/include)
add_executable(rdof_sdr_tests test_sdr.c ${RDOF_NC_TEMPCAL})
add_dependencies(rdof_sdr_tests rdof_sdr_vectors)
target_include_directories(rdof_sdr_tests PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${RDOF_SDR_GEN} ${RDOF_NC_INCLUDE})
target_compile_definitions(rdof_sdr_tests PRIVATE RDOF_SDR_DATA="${RDOF_SDR_GEN}/sdr-data/")
target_link_libraries(rdof_sdr_tests PRIVATE rdof_sdr)
set_target_properties(rdof_sdr_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_compile_options(rdof_sdr_tests PRIVATE -Wall -Wno-unused-parameter)
if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
    target_compile_options(rdof_sdr PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_compile_options(rdof_sdr_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(rdof_sdr_tests PRIVATE -fsanitize=address,undefined)
endif()
add_test(NAME rdof_sdr_tests COMMAND rdof_sdr_tests)

