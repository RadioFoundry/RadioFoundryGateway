// 2 radios split repeater (host ports)
{
 "version": 3,
 "id": 9800100,
 "callsign": "N0CALL",
 "defaults": {
  "cc": 1
 },
 "devices": [
  {
   "name": "m0",
   "kind": "modem",
   "type": "radio_hotspot",
   "port": {
    "path": "/dev/ttyACM0"
   },
   "hears": {
    "idle": "in"
   },
   "transmits": false
  },
  {
   "name": "m1",
   "kind": "modem",
   "type": "radio_hotspot",
   "port": {
    "path": "/dev/ttyACM1"
   },
   "hears": false,
   "transmits": [
    "out"
   ]
  }
 ],
 "frequencies": [
  {
   "name": "in",
   "freq": 438.75
  },
  {
   "name": "out",
   "freq": 438.25
  }
 ],
 "apps": [
  {
   "name": "R1",
   "type": "repeater",
   "in": "in",
   "out": "out"
  }
 ],
 "networks": [
  {
   "type": "hblink",
   "host": "hb.example.net"
  }
 ]
}
