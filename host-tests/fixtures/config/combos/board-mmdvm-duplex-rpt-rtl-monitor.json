// mmdvm duplex rpt + rtl monitor (board ports)
{
 "version": 3,
 "id": 9800100,
 "callsign": "N0CALL",
 "defaults": {
  "cc": 1
 },
 "devices": [
  {
   "name": "m0",
   "kind": "modem",
   "type": "mmdvm",
   "port": {
    "uart": 1,
    "tx": 17,
    "rx": 18
   }
  },
  {
   "name": "rtl",
   "kind": "sdr",
   "driver": "rtlsdr",
   "rx": {
    "rate": 288000
   }
  }
 ],
 "frequencies": [
  {
   "name": "in",
   "freq": 438.55
  },
  {
   "name": "out",
   "freq": 438.5
  },
  {
   "freq": 438.5125,
   "tx": false
  }
 ],
 "apps": [
  {
   "name": "R1",
   "type": "repeater",
   "in": "in",
   "out": "out"
  }
 ],
 "networks": [
  {
   "type": "hblink",
   "host": "hb.example.net"
  }
 ]
}
