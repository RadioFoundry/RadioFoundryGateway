// pluto rx + 1 radio-tx split repeaters (host ports)
{
 "version": 3,
 "id": 9800100,
 "callsign": "N0CALL",
 "defaults": {
  "cc": 1
 },
 "devices": [
  {
   "name": "pluto",
   "kind": "sdr",
   "driver": "iio",
   "transmits": false
  },
  {
   "name": "m0",
   "kind": "modem",
   "type": "radio_hotspot",
   "port": {
    "path": "/dev/ttyACM0"
   },
   "hears": false,
   "transmits": [
    "out0"
   ]
  }
 ],
 "frequencies": [
  {
   "name": "in0",
   "freq": 438.75
  },
  {
   "name": "out0",
   "freq": 438.25
  }
 ],
 "apps": [
  {
   "name": "R0",
   "type": "repeater",
   "in": "in0",
   "out": "out0"
  }
 ],
 "networks": [
  {
   "type": "hblink",
   "host": "hb.example.net"
  }
 ]
}
