// pluto + rtl (host ports)
{
 "version": 3,
 "id": 9800100,
 "callsign": "N0CALL",
 "defaults": {
  "cc": 1
 },
 "devices": [
  {
   "name": "pluto",
   "kind": "sdr",
   "driver": "iio"
  },
  {
   "name": "rtl0",
   "kind": "sdr",
   "driver": "rtlsdr",
   "match": {
    "serial": "00000000"
   },
   "rx": {
    "rate": 288000
   }
  }
 ],
 "frequencies": [
  {
   "name": "in",
   "freq": 438.75
  },
  {
   "name": "out",
   "freq": 438.25
  },
  {
   "freq": 146.52,
   "tx": false,
   "devices": [
    "rtl0"
   ]
  }
 ],
 "apps": [
  {
   "name": "R1",
   "type": "repeater",
   "in": "in",
   "out": "out"
  }
 ],
 "networks": [
  {
   "type": "hblink",
   "host": "hb.example.net"
  }
 ]
}
