// lr2021 rx + radio tx split repeater (board ports)
{
 "version": 3,
 "id": 9800100,
 "callsign": "N0CALL",
 "defaults": {
  "cc": 1
 },
 "devices": [
  {
   "name": "w12",
   "kind": "sdr",
   "driver": "lr2021",
   "rx": {
    "rate": 240000
   },
   "tx": {
    "power_dbm": 10
   },
   "transmits": false
  },
  {
   "name": "m0",
   "kind": "modem",
   "type": "radio_hotspot",
   "port": {
    "uart": 1,
    "tx": 17,
    "rx": 18
   },
   "hears": false,
   "transmits": [
    "out"
   ]
  }
 ],
 "frequencies": [
  {
   "name": "in",
   "freq": 438.55
  },
  {
   "name": "out",
   "freq": 438.5
  }
 ],
 "apps": [
  {
   "name": "R1",
   "type": "repeater",
   "in": "in",
   "out": "out"
  }
 ],
 "networks": [
  {
   "type": "hblink",
   "host": "hb.example.net"
  }
 ]
}
