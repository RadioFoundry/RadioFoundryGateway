# The host web page (hostweb/): the firmware's UI and status API for a host tool. Included from CMakeLists.txt after
# sdr.cmake. A test of the server always builds (POSIX only), and rdofradio's settings (--config) with their test;
# RDOF_HOST_WEB (sdr/cli/tools.cmake) links the server into rdofradio and turns on its --web flag
# (hostweb/README.md).
if(NOT WIN32)
    add_subdirectory(../hostweb hostweb)
    add_executable(rdof_hostweb_tests ../hostweb/test/test_hostweb.c)
    target_link_libraries(rdof_hostweb_tests PRIVATE rdof_hostweb)
    set_target_properties(rdof_hostweb_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
    target_compile_options(rdof_hostweb_tests PRIVATE -Wall -Wno-unused-parameter)
    if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(rdof_hostweb_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(rdof_hostweb_tests PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME rdof_hostweb_tests COMMAND rdof_hostweb_tests)
    # rdofradio's settings (--config FILE): the firmware's document as rdofradio runs it
    add_executable(rdof_radiocfg_tests test_radiocfg.c ../sdr/cli/rdofradio_cfg.c)
    target_include_directories(rdof_radiocfg_tests PRIVATE ../sdr/cli)
    target_link_libraries(rdof_radiocfg_tests PRIVATE rdof_sdr_core m)
    set_target_properties(rdof_radiocfg_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
    target_compile_options(rdof_radiocfg_tests PRIVATE -Wall -Wno-unused-parameter)
    if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(rdof_radiocfg_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(rdof_radiocfg_tests PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME rdof_radiocfg_tests COMMAND rdof_radiocfg_tests)
    # Which hardware mixes the open, a board and rdofradio take (fixtures/config/combos/expect.txt)
    add_executable(rdof_combos_tests test_combos.c ../sdr/cli/rdofradio_cfg.c)
    target_include_directories(rdof_combos_tests PRIVATE ../sdr/cli)
    target_link_libraries(rdof_combos_tests PRIVATE rdof_sdr_core m)
    set_target_properties(rdof_combos_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
    target_compile_options(rdof_combos_tests PRIVATE -Wall -Wno-unused-parameter)
    if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(rdof_combos_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(rdof_combos_tests PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME rdof_combos_tests COMMAND rdof_combos_tests ${CMAKE_CURRENT_SOURCE_DIR}/fixtures/config/combos
        ${CMAKE_CURRENT_SOURCE_DIR}/../config/examples)
    # rdofradio's HBlink4 peer against a fake master on the loopback
    add_executable(rdof_rdofnet_tests test_rdofnet.c ../sdr/cli/rdofradio_net.c)
    target_include_directories(rdof_rdofnet_tests PRIVATE ../sdr/cli)
    target_link_libraries(rdof_rdofnet_tests PRIVATE rdof_common)
    set_target_properties(rdof_rdofnet_tests PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
    target_compile_options(rdof_rdofnet_tests PRIVATE -Wall -Wno-unused-parameter)
    if(RDOF_SANITIZE AND NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(rdof_rdofnet_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(rdof_rdofnet_tests PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME rdof_rdofnet_tests COMMAND rdof_rdofnet_tests)
    set_tests_properties(rdof_rdofnet_tests PROPERTIES TIMEOUT 30)
endif()
