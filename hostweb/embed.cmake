# cmake -DOUT=file.c -DFILES="name=path;name=path" -P embed.cmake: each file as a byte array
# (rdof_hostweb_asset_<n>[] and _len), and a table of them. Without a tool beyond CMake.
set(c "// Generated by embed.cmake; do not edit.\n#include <stddef.h>\n#include \"assets.h\"\n")
set(table "")
set(i 0)
foreach(item ${FILES})
    string(FIND "${item}" "=" eq)
    string(SUBSTRING "${item}" 0 ${eq} name)
    math(EXPR eq "${eq} + 1")
    string(SUBSTRING "${item}" ${eq} -1 path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(LENGTH "${hex}" hl)
    math(EXPR n "${hl} / 2")
    string(APPEND c "static const unsigned char a${i}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", a${i}, ${n}},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND c "const rdof_hostweb_asset_t rdof_hostweb_assets[] = {\n${table}    {NULL, NULL, 0}};\n")
file(WRITE "${OUT}" "${c}")
