# Meshnology W12 (ESP32-S3R8: 16 MB flash, 8 MB octal PSRAM; a Semtech LR2021 on SPI). Layer it on 16mb:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.16mb;sdkconfig.defaults.w12" build
# One USB-C on the native USB (no UART bridge): flash in ROM download mode; console on UART0 (GPIO43 / 44) and,
# as a second console, the USB serial port, the board's only way out without wiring (it would be lost if USB host
# started, so USB host is off below).
# The LR2021's pins are the defaults of "LR2021 pins and options". NOT RUN ON THE BOARD YET.
# Its RGB LED
CONFIG_RDOF_STATUS_LED_GPIO=46
# The GNSS header (an L76K, sold separately): power switch GPIO48 (active low, per the Meshtastic port), PPS on
# GPIO41 (Meshnology's pin table). UART RX 39 / TX 38, WAKE 40, RESET 42 aren't used. Unchecked on a board.
CONFIG_RDOF_GNSS_EN_GPIO=48
CONFIG_RDOF_GNSS_EN_LEVEL=0
CONFIG_NETCLOCK_PPS_GPIO=41
# Its NMEA (9600 baud): the pin table's RX 39 / TX 38; autodetect tries them swapped too
CONFIG_GNSS_UART_RX_GPIO=39
CONFIG_GNSS_UART_TX_GPIO=38
CONFIG_RDOF_SDR_LR2021=y
# USB host off while the LR2021 is brought up: the USB port stays the serial console and flashing port
# CONFIG_RDOF_USB_HOST is not set
# No log on the USB serial port: with nothing reading it, writes stall and the SDR's ring overflows (2026-10-24:
# about 150 KB/s of 768 KB/s lost and 6 KB less internal RAM). UART0 still has the log; turn it on for a session.
# FreeRTOS run-time stats: the LR2021 reader logs its share of core 0 every minute
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# The OLED (an SSD1315, SSD1306 compatible, 128x64 at 0x3C; yellow top 16 rows, blue below) on SDA 17 / SCL 18, on
# unless the settings say "oled": false. VEXT_EN (GPIO45) powers it, active low (Meshtastic's W12 variant).
CONFIG_RDOF_OLED_BUILTIN=y
CONFIG_RDOF_OLED_SDA=17
CONFIG_RDOF_OLED_SCL=18
CONFIG_RDOF_OLED_POWER_GPIO=45
CONFIG_RDOF_OLED_POWER_LEVEL=0
# A 1 MB sample ring (1.4 s at 384 kS/s): the DSP's hot buffers are in PSRAM here (no internal RAM for them), and
# core 0's traffic (the web page, MQTT during a call) slows it for a second at a time; 256 KB overflowed then.
CONFIG_RDOF_SDR_RING_KB=1024
# Wi-Fi's hot code in flash, not IRAM (which is the heap's SRAM on the S3): about 27 KB more internal RAM, so the
# SDR and an sdr_transceiver fit together (with both IRAM options on, Wi-Fi ran out, 2026-10-24). Wi-Fi's peak
# throughput, which nothing here needs, is what it costs.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# The memory plan's margin: with the SDR and an sdr_transceiver, what isn't planned (Wi-Fi, lwIP, TLS, the web
# server) took more than 80 KB, and the roamer's stacks, planned into the 80's spare, left the heap with 0.3 KB.
CONFIG_RDOF_MEM_MARGIN_KB=96
