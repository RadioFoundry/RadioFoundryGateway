# Today's board: ESP32-S3 SuperMini, ESP32-S3FH4R2 (4 MB flash, 2 MB quad PSRAM, both in package).
# One USB-C on the native USB (GPIO19/20), no UART bridge: flash in ROM download mode, console on UART0.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4mb.csv"

# Wi-Fi at 10 dBm at most: at 15 or more the SuperMini's regulator can brown out when it transmits.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
# Its RGB LED (WS2812)
CONFIG_RDOF_STATUS_LED_GPIO=48

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# .bss marked EXT_RAM_BSS_ATTR in PSRAM: the bench API's buffers, so internal RAM stays the DSP's
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Features: two OTA slots still fit with everything but MQTT TLS (see docs/reference.md, "Size").
CONFIG_RDOF_WEB_FULL=y
CONFIG_RDOF_OTA=y
CONFIG_RDOF_MQTT_TLS=n
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
CONFIG_RDOF_LOG_RING_KB=16
CONFIG_RDOF_SOFTAP=y
# A crash saves a core dump to the last 128 KB of flash (GET /api/coredump).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
